rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isApprover() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'approver']);
    }
    
    function isCreator() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'approver', 'creator']);
    }
    
    function isViewer() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'approver', 'creator', 'viewer']);
    }
    
    // ===== USERS COLLECTION =====
    match /users/{userId} {
      allow read: if isAuthenticated(); // All authenticated users can read
      allow write: if isAdmin() || request.auth.uid == userId; // Admin or self
      allow delete: if isAdmin(); // Only admin can delete
    }
    
    // ===== CHAT PROFILES =====
    match /chat_profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        (request.auth.uid == userId || isAdmin());
    }
    
    // ===== CHAT MESSAGES =====
    match /chat_messages/{messageId} {
      allow read: if isAuthenticated() && 
        (resource.data.conversationType == 'team' || 
         (resource.data.conversationType == 'direct' && 
          resource.data.participants.hasAny([request.auth.uid])));
      
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.conversationType == 'team' || 
         (request.resource.data.conversationType == 'direct' && 
          request.resource.data.participants.hasAll([request.auth.uid, request.resource.data.participants[0]])));
      
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['text', 'editedAt']);
      
      allow delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // ===== COMMS_MONITORING =====
    match /comms_monitoring/{docId} {
      allow read: if isAuthenticated() && isViewer();
      allow create: if isAuthenticated() && isCreator();
      allow update: if isAuthenticated() && isCreator();
      allow delete: if isAuthenticated() && isAdmin();
      
      // Additional permission checks in app logic
      validate: if request.resource.data.status in ['draft', 'pending', 'approved', 'released', 'rejected'];
    }
    
    // ===== METADATA =====
    match /metadata/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || 
        (resource == null && request.resource.data.reservations != null);
    }
    
    // ===== ANALYTICS (optional) =====
    // Consider using separate analytics collection with stricter access
  }
}